ps_1_4

; per pixel lighting with specular using illumination table lookup
; 
texld r0, t0		; fetch color
texld r1, t1		; fetch normalmap
texcrd r2.rgb, t2	; L0
texcrd r3.rgb, t3	; H0
texcrd r4.rgb, t4	; L1
texcrd r5.rgb, t5	; H1

	dp3_sat r2.r, r1_bx2, r2
	dp3_sat r2.a, r1_bx2, r3
	dp3_sat r4.r, r1_bx2, r4
	dp3_sat r4.a, r1_bx2, r5
	mul  r2.b, r2.a, r2.a
	+mul r4.a, r4.a, r4.a
	mul  r2.b, r2.b, r2.b
	+mul r4.a, r4.a, r4.a
	mul  r2.b, r2.b, r2.b
	mul  r4.b, r4.a, r4.a
	
phase
texld r0, t0		; fetch color
texld r1, t1		; fetch normalmap
		
	mad r2.rgb, c1, r2.r, c0
	+ mul r2.a, r2.b, c1.a
	mad r2.rgb, c2, r3.r, r2
	+ mad r2.a, r4.b, c2.a, r2.a
	mul r0.rgb, r2, r0
	mad_x2 r0.rgb, r1.a, r2.a, r0
	+ mov r0.a, r0.a

