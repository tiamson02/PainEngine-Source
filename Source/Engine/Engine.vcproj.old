	<Platforms>
		<Platform
			Name="Win32"/>
	</Platforms>
	<Configurations>
		<Configuration
			Name="Debug|Win32"
			OutputDirectory="../../Bin"
			IntermediateDirectory="../../Bin/ObjectsDebug/Engine"
			ConfigurationType="2"
			CharacterSet="2">
			<Tool
				Name="VCCLCompilerTool"
				Optimization="0"
				AdditionalIncludeDirectories="../External/miles/include;.;../Base;../External/Havok/include"
				PreprocessorDefinitions="WIN32;_DEBUG;_WINDOWS;_USRDLL;ENGINE_API=__declspec(dllexport)"
				MinimalRebuild="TRUE"
				BasicRuntimeChecks="3"
				RuntimeLibrary="5"
				UsePrecompiledHeader="3"
				PrecompiledHeaderThrough="Engine.h"
				WarningLevel="4"
				Detect64BitPortabilityProblems="FALSE"
				DebugInformationFormat="4"/>
			<Tool
				Name="VCCustomBuildTool"/>
			<Tool
				Name="VCLinkerTool"
				AdditionalDependencies="hkbase.lib hkdynamics2.lib hkcollide2.lib hkconstraintsolver2.lib hkutilities2.lib hkgeometry2.lib hkgeometryutil2.lib hkmath2.lib hkexport2.lib ws2_32.lib mss32.lib"
				OutputFile="$(OutDir)/Engine.dll"
				LinkIncremental="2"
				AdditionalLibraryDirectories="../External/miles/lib/win;&quot;../External/havok/lib/win32-net/debug&quot;"
				GenerateDebugInformation="TRUE"
				ProgramDatabaseFile="$(IntDir)/$(ProjectName).pdb"
				SubSystem="2"
				ImportLibrary="$(IntDir)/Engine.lib"
				TargetMachine="1"/>
			<Tool
				Name="VCMIDLTool"/>
			<Tool
				Name="VCPostBuildEventTool"/>
			<Tool
				Name="VCPreBuildEventTool"/>
			<Tool
				Name="VCPreLinkEventTool"/>
			<Tool
				Name="VCResourceCompilerTool"/>
			<Tool
				Name="VCWebServiceProxyGeneratorTool"/>
			<Tool
				Name="VCWebDeploymentTool"/>
		</Configuration>
		<Configuration
			Name="Release|Win32"
			OutputDirectory="../../Bin"
			IntermediateDirectory="../../Bin/ObjectsRelease/Engine"
			ConfigurationType="2"
			CharacterSet="2"
			WholeProgramOptimization="FALSE">
			<Tool
				Name="VCCLCompilerTool"
				Optimization="3"
				GlobalOptimizations="TRUE"
				InlineFunctionExpansion="2"
				EnableIntrinsicFunctions="TRUE"
				FavorSizeOrSpeed="1"
				OmitFramePointers="TRUE"
				OptimizeForProcessor="2"
				AdditionalIncludeDirectories="../External/miles/include;.;../Base;../External/Havok/include"
				PreprocessorDefinitions="WIN32;NDEBUG;_WINDOWS;_USRDLL;ENGINE_API=__declspec(dllexport)"
				StringPooling="TRUE"
				ExceptionHandling="TRUE"
				BasicRuntimeChecks="0"
				RuntimeLibrary="4"
				StructMemberAlignment="5"
				BufferSecurityCheck="FALSE"
				EnableFunctionLevelLinking="FALSE"
				UsePrecompiledHeader="3"
				PrecompiledHeaderThrough="Engine.h"
				WarningLevel="4"
				Detect64BitPortabilityProblems="FALSE"
				DebugInformationFormat="3"/>
			<Tool
				Name="VCCustomBuildTool"/>
			<Tool
				Name="VCLinkerTool"
				AdditionalDependencies="hkbase.lib hkdynamics2.lib hkcollide2.lib hkconstraintsolver2.lib hkutilities2.lib hkgeometry2.lib hkgeometryutil2.lib hkmath2.lib hkexport2.lib ws2_32.lib mss32.lib"
				OutputFile="$(OutDir)/Engine.dll"
				LinkIncremental="1"
				AdditionalLibraryDirectories="../External/miles/lib/win;../External/havok/lib/win32-net/release"
				IgnoreDefaultLibraryNames="libcmt"
				GenerateDebugInformation="TRUE"
				ProgramDatabaseFile="$(IntDir)/$(ProjectName).pdb"
				SubSystem="2"
				OptimizeReferences="2"
				EnableCOMDATFolding="2"
				ImportLibrary="$(IntDir)/Engine.lib"
				TargetMachine="1"/>
			<Tool
				Name="VCMIDLTool"/>
			<Tool
				Name="VCPostBuildEventTool"/>
			<Tool
				Name="VCPreBuildEventTool"/>
			<Tool
				Name="VCPreLinkEventTool"/>
			<Tool
				Name="VCResourceCompilerTool"/>
			<Tool
				Name="VCWebServiceProxyGeneratorTool"/>
			<Tool
				Name="VCWebDeploymentTool"/>
		</Configuration>
	</Configurations>
