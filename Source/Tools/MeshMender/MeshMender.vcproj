<?xml version="1.0" encoding="Windows-1252"?>
<VisualStudioProject
	ProjectType="Visual C++"
	Version="7.10"
	Name="MeshMender"
	ProjectGUID="{27282973-4F76-4FA0-BE7B-6685A5E25626}"
	SccProjectName="SAK"
