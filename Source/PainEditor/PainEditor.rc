IDR_MAINFRAME MENU 
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&Create New Project\tCtrl+N", ID_FILE_NEW
        MENUITEM SEPARATOR
        MENUITEM "&Load Level",                 ID_FILE_LOADLEVEL
        MENUITEM "&Save Level Properties",      32822
        MENUITEM "Save Level and Objects",      32929
        MENUITEM "Save All &As...",             ID_FILE_SAVELEVELAS
        MENUITEM SEPARATOR
        MENUITEM "&Close Level",                ID_FILE_CLOSE
        MENUITEM SEPARATOR
        MENUITEM "Script C&ommand\tCtrl+L",     ID_EDIT_COMMAND
        MENUITEM SEPARATOR
        MENUITEM "Extract Game Data",           ID_FILE_EXTRACTGAMEDATA
        MENUITEM SEPARATOR
        MENUITEM "E&xit",                       ID_APP_EXIT
    END
    POPUP "&Objects"
    BEGIN
        MENUITEM "New Object\tCtrl+O",          ID_OBJECTS_NEWOBJECT
        MENUITEM "Reset Selected Object",       ID_OBJECTS_RESETSELECTED
        MENUITEM "Save Selected Object",        ID_OBJECTS_SAVESELECTED
        MENUITEM SEPARATOR
        POPUP "Lights and Environments"
        BEGIN
            MENUITEM "Scale",                       ID_LIGHTS_SCALE
            MENUITEM "Save All",                    ID_LIGHTS_SAVEALL
        END
        POPUP "Areas"
        BEGIN
            MENUITEM "Save All",                    ID_AREAS_SAVEALL
        END
        POPUP "Items"
        BEGIN
            MENUITEM "Scale",                       ID_ITEMS_SCALE
            MENUITEM "Save All",                    ID_ITEMS_SAVEALL
        END
        POPUP "Sounds"
        BEGIN
            MENUITEM "Save All",                    ID_SOUNDS_SAVEALL
        END
    END
    POPUP "Scripts"
    BEGIN
        MENUITEM "Toggle Breakpoint\tF9",       ID_SCRIPTS_TOGGLEBREAKPOINT
        MENUITEM SEPARATOR
        MENUITEM "Step Over\tF10",              ID_SCRIPTS_STEPOVER
        MENUITEM "Step Into\tF11",              ID_SCRIPTS_STEPINTO
        MENUITEM SEPARATOR
        MENUITEM "Clear All Breakpoints",       ID_SCRIPTS_CLEARALLBREAKPOINTS

    END
    POPUP "&Pathfinding"
    BEGIN
        MENUITEM "&Load Map",                   ID_PATHFINDING_LOADMAP
        MENUITEM "Load Map Without Portals",    ID_PATHFINDING_LOADMAPWITHOUTPORTALS

        MENUITEM "&Merge Map",                  ID_PATHFINDING_MERGEMAP
        MENUITEM "&Save Map",                   ID_PATHFINDING_SAVEMAP
        MENUITEM "&Import Old Waypoints",       ID_PATHFINDING_IMPORTOLDWAYPOINTS

        MENUITEM SEPARATOR
        POPUP "&Way Points"
        BEGIN
            MENUITEM "Select All",                  ID_WAYPOINTS_SELECTALL
            MENUITEM "Select Outside of Current Zone", 
                                                    ID_WAYPOINTS_SELECTOUTSIDEOFCURRENTZONE

            MENUITEM "Select Not Connected to Anything in Current Room", 
                                                    ID_WAYPOINTS_SELECTNOTCONNECTEDTOANYTHINGINCURRENTROOM

            MENUITEM "Invert Selection",            ID_WAYPOINTS_INVERTSELECTION

            MENUITEM "&Unselect All",               ID_WAYPOINTS_UNSELECTALL
            MENUITEM SEPARATOR
            MENUITEM "&Connect/Disconnect Selected\tCtrl+D", 
                                                    ID_WAYPOINTS_CONNECTSELECTED

            MENUITEM "&Delete Selected\tCtrl+X",    ID_WAYPOINTS_DELETESELECTED

            MENUITEM "Move Selected To The Zone They're In", 
                                                    ID_WAYPOINTS_MOVESELECTEDTOTHEZONE

            MENUITEM "Set Selected as for All Monsters", 
                                                    ID_WAYPOINTS_SETSELECTEDASFORALLMONSTERS

            MENUITEM "Set Selected as for Small Monsters Only", 
                                                    ID_WAYPOINTS_SETSELECTEDASFORSMALLMONSTERSONLY

        END
        MENUITEM SEPARATOR
        MENUITEM "&Prepare Floors",             ID_PATHFINDING_RECALCULATEFLOORS

        MENUITEM "Prepare Portal &Nodes",       ID_PATHFINDING_PREPAREPORTALNODES

        MENUITEM "Generate Way Points from Floors", 32819
        MENUITEM "Level Waypoints with Floors", ID_PATHFINDING_LEVELWAYPOINTSWITHFLOORS

        MENUITEM "Scale Contents",              ID_PATHFINDING_SCALECONTENTS
        MENUITEM "Clean Structures",            ID_PATHFINDING_CLEANSTRUCTURES

        MENUITEM SEPARATOR
        MENUITEM "&Find Path\tCtrl+F",          ID_PATHFINDING_FINDPATH
    END
    POPUP "&View"
    BEGIN
        MENUITEM "Standard Bar",                ID_VIEW_TOOLBAR
        MENUITEM "&Status Bar",                 ID_VIEW_STATUS_BAR
        MENUITEM SEPARATOR
        MENUITEM "Game Objects",                ID_VIEW_GOBJECTS
        MENUITEM "Properties",                  ID_VIEW_PROPERTIES
        MENUITEM "Templates",                   ID_VIEW_TEMPLATES
        MENUITEM "Entities",                    ID_VIEW_ENTITIES
        MENUITEM "Output",                      ID_VIEW_OUTPUT
        MENUITEM "Watch Bar",                   ID_VIEW_WATCHBAR
        MENUITEM "S&cript Explorer",            ID_VIEW_SCRIPTS
        MENUITEM "Emitter Editor",              ID_VIEW_EMITTER
        MENUITEM "ParticleFX Editor",           ID_VIEW_PARTICLEFX
    END
    POPUP "&Window"
    BEGIN
        MENUITEM "&Cascade",                    ID_WINDOW_CASCADE
        MENUITEM "&Tile",                       ID_WINDOW_TILE_HORZ
        MENUITEM "&Arrange Icons",              ID_WINDOW_ARRANGE
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&Help Topics",                ID_HELP_FINDER
        MENUITEM SEPARATOR
        MENUITEM "&About PainEditor...",        ID_APP_ABOUT
    END
END

ID_VIEW_MODE MENU 
BEGIN
    POPUP "DropMenuClick"
    BEGIN
        MENUITEM "Visibility",                  ID_RENDERVIEW_VISIBILITY
        , CHECKED
        MENUITEM SEPARATOR
        MENUITEM "Textures",                    ID_RENDERVIEW_TEXTURES
        , CHECKED
        MENUITEM "Lightmaps",                   ID_RENDERVIEW_LIGHTMAPS
        , CHECKED
        MENUITEM "Wireframe",                   ID_RENDERVIEW_WIREFRAME
        MENUITEM SEPARATOR
        MENUITEM "Models",                      ID_RENDERVIEW_MODELS
        , CHECKED
        MENUITEM "Zones",                       ID_RENDERVIEW_ZONES
        MENUITEM "Boxes",                       ID_RENDERVIEW_BOXES
        MENUITEM "Volumetrics",                 ID_RENDERVIEW_VOLUMETRICS
        MENUITEM SEPARATOR
        MENUITEM "Monster Sight",               ID_RENDERVIEW_MONSTERSIGHT
        MENUITEM "Physical Model",              ID_RENDERVIEW_PHYSICALMODEL
        MENUITEM "Havok Primitives",            ID_RENDERVIEW_HAVOKPRIMITIVES

    END
END


