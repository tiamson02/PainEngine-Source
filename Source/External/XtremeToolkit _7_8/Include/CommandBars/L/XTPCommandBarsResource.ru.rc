XTP_IDD_IMAGEEDITOR_DIALOG DIALOGEX 0, 0, 253, 185
STYLE DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Редактор кнопок"
FONT 8, "MS Sans Serif"
BEGIN
    LTEXT           "Рисунок",IDC_STATIC,7,7,23,8
    GROUPBOX        "Цвета",IDC_STATIC,102,106,80,71
    GROUPBOX        "Перемещение",IDC_STATIC,101,72,81,31
    GROUPBOX        "Просмотр",IDC_STATIC,7,106,86,71
    GROUPBOX        "Инструменты",IDC_STATIC,101,9,81,60
    DEFPUSHBUTTON   "OK",IDOK,193,7,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,193,25,50,14
    CONTROL         "",XTP_IDC_STATIC_PICTURE,"Static",SS_BLACKFRAME | 
                    SS_NOTIFY,7,17,86,80
    CTEXT           "",XTP_IDC_STATIC_PREVIEW,14,117,73,54,SS_CENTERIMAGE,
                    WS_EX_STATICEDGE
    LTEXT           "Удалить",IDC_STATIC,135,156,39,8
    LTEXT           "",XTP_ID_CLR_ERASE,116,153,15,15,SS_NOTIFY
    CTEXT           "Tools",XTP_IDC_STATIC_TOOLS,112,21,60,43,SS_CENTERIMAGE | 
                    NOT WS_VISIBLE | WS_BORDER
    CTEXT           "Move",XTP_IDC_STATIC_MOVE,111,83,62,12,SS_CENTERIMAGE | 
                    NOT WS_VISIBLE | WS_BORDER
    CONTROL         "",XTP_ID_CLR_PICKER,"Static",SS_LEFTNOWORDWRAP | 
                    SS_NOTIFY | WS_GROUP,109,144,15,15
    CTEXT           "Colors",XTP_IDC_STATIC_COLORS,107,121,68,12,
                    SS_CENTERIMAGE | NOT WS_VISIBLE | WS_BORDER
END

XTP_IDD_PAGE_KEYBOARD DIALOG DISCARDABLE  0, 0, 230, 150
STYLE WS_CHILD | WS_CAPTION
CAPTION "&Клавиатура"
FONT 8, "MS Sans Serif"
BEGIN
    LTEXT           "Ко&манды:",XTP_IDC_TXT_COMMANDS,2,28,38,8
    LISTBOX         XTP_IDC_LBOX_ACCEL_COMMANDS,2,39,93,74,
                    LBS_HASSTRINGS | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | 
                    WS_TABSTOP
    LTEXT           "У&же назначены:",XTP_IDC_TXT_ASSIGNMENTS,100,28,67,
                    8
    LISTBOX         XTP_IDC_LBOX_KEYS,100,38,75,49, LBS_HASSTRINGS | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP
    LTEXT           "&Новая клавиша:",XTP_IDC_TXT_NEWKEY,100,91,76,8
    EDITTEXT        XTP_IDC_EDIT_SHORTCUTKEY,100,101,75,12,ES_AUTOHSCROLL
    PUSHBUTTON      "Н&азначить",XTP_IDC_BTN_ASSIGN,179,39,49,14
    PUSHBUTTON      "&Удалить",XTP_IDC_BTN_REMOVE,179,56,49,14
    PUSHBUTTON      "С&брос",XTP_IDC_BTN_ACCEL_RESET,179,73,49,14
    LTEXT           "Описание:",XTP_IDC_TXT_DESC_TITLE,2,119,38,8
    LTEXT           "",XTP_IDC_TXT_DESC_OVERVIEW,2,129,173,19,0,
                    WS_EX_STATICEDGE
    LTEXT           "Ка&тегория:",IDC_STATIC,2,5,50,8
    COMBOBOX        XTP_IDC_COMBO_CATEGORY,2,15,93,147,CBS_DROPDOWNLIST | 
                    WS_VSCROLL | WS_TABSTOP
END
XTP_IDD_PAGE_TOOLBARS DIALOG DISCARDABLE  0, 0, 230, 150
STYLE WS_CHILD | WS_CAPTION
CAPTION "Панели &инструментов"
FONT 8, "MS Sans Serif"
BEGIN
    LTEXT           "Па&нели инструментов:",IDC_STATIC,4,5,30,8
    LISTBOX         XTP_IDC_LIST_TOOLBARS,4,15,150,131,LBS_OWNERDRAWFIXED | 
                    LBS_HASSTRINGS | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | 
                    WS_TABSTOP
    PUSHBUTTON      "Со&здать...",XTP_IDC_BUTTON_NEW,158,15,70,14
    PUSHBUTTON      "П&ереименовать...",XTP_IDC_BUTTON_RENAME,158,33,70,14
    PUSHBUTTON      "&Удалить",XTP_IDC_BUTTON_DELETE,158,51,70,14
    PUSHBUTTON      "С&брос...",XTP_IDC_BUTTON_RESET,158,69,70,14
END

XTP_IDD_PAGE_OPTIONS DIALOG DISCARDABLE  0, 0, 230, 150
STYLE WS_CHILD | WS_CAPTION
CAPTION "П&араметры"
FONT 8, "MS Sans Serif"
BEGIN
    LTEXT           "Настраиваемые меню и панели инструментов",IDC_STATIC,7,5,110,8
    CONTROL         "",IDC_STATIC,"Static",SS_ETCHEDHORZ,122,9,101,1
    CONTROL         "Всегда показывать полные &меню",XTP_IDC_CHECK_FULL_MENUS,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,16,17,207,10
    CONTROL         "Показывать &полные меню после короткой задержки",
                    XTP_IDC_CHECK_AFTERDELAY,"Button",BS_AUTOCHECKBOX | 
                    WS_TABSTOP,28,29,195,10
    PUSHBUTTON      "С&брос",XTP_IDC_BUTTON_RESETDATA,16,42,78,
                    14
    LTEXT           "Другие",IDC_STATIC,7,70,28,8
    CONTROL         "",IDC_STATIC,"Static",SS_ETCHEDHORZ,35,74,194,1
    CONTROL         "Крупны&е значки",XTP_IDC_CHECK_LARGEICONS,"Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP,16,82,207,10
    CONTROL         "&Отображать подсказки для кнопок",XTP_IDC_CHECK_SCREENTTIPS,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,16,93,207,10
    CONTROL         "Вклю&чить в подсказки сочетания клавиш",
                    XTP_IDC_CHECK_SHORTCUTS,"Button",BS_AUTOCHECKBOX | 
                    WS_TABSTOP,28,104,195,10
    LTEXT           "&Анимация меню:",IDC_STATIC,16, 117,74,8
    COMBOBOX        XTP_IDC_COMBO_ANIMATION,76,115,79,65,CBS_DROPDOWNLIST | 
                    WS_VSCROLL | WS_TABSTOP

END

XTP_IDD_PAGE_COMMANDS DIALOG DISCARDABLE  0, 0, 230, 150
STYLE WS_CHILD | WS_CAPTION
CAPTION "&Команды"
FONT 8, "MS Sans Serif"
BEGIN
    LTEXT           "Чтобы добавить команду на панель инструментов, выберите категорию и перетащите команду из этого окна на панель.",
                    IDC_STATIC,4,5,220,19
    LTEXT           "Кате&гории:",IDC_STATIC,4,25,38,8
    LISTBOX         XTP_IDC_LIST_CATEGORIES,4,35,81,103,LBS_NOINTEGRALHEIGHT | 
                    WS_VSCROLL | WS_TABSTOP
    LTEXT           "Ко&манды:",IDC_STATIC,90,25,38,8
    LISTBOX         XTP_IDC_LIST_COMMANDS,90,35,140,103,LBS_OWNERDRAWFIXED | 
                    LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP
   
END

XTP_IDD_NEWTOOLBAR DIALOG DISCARDABLE  0, 0, 186, 52
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Создание панели инструментов"
FONT 8, "MS Sans Serif"
BEGIN
    LTEXT           "Панель &инструментов:",IDC_STATIC,4,4,119,8
    EDITTEXT        XTP_IDC_EDIT_TOOLBARNAME,4,15,178,12,ES_AUTOHSCROLL
    DEFPUSHBUTTON   "OK",IDOK,78,34,50,14
    PUSHBUTTON      "Отмена",IDCANCEL,132,34,50,14
END

/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

XTP_IDR_CUSTOMIZEMENU MENU DISCARDABLE 
BEGIN
    POPUP "Customize"
    BEGIN
        MENUITEM "С&брос",                      XTP_ID_CUSTOMIZE_RESET
        MENUITEM "&Удалить",                    XTP_ID_CUSTOMIZE_DELETE
        MENUITEM SEPARATOR
        MENUITEM "Им&я:",                       XTP_ID_CUSTOMIZE_NAME
        MENUITEM SEPARATOR
        MENUITEM "&Копировать значок на кнопке", 
                                                XTP_ID_CUSTOMIZE_COPYBUTTONIMAGE

        MENUITEM "Вст&авить значок для кнопки", XTP_ID_CUSTOMIZE_PASTEBUTTONIMAGE

        MENUITEM "&Восстановить значок на кнопке", 
                                                XTP_ID_CUSTOMIZE_RESETBUTTONIMAGE

        MENUITEM "&Изменить значок на кнопке...", 
                                                XTP_ID_CUSTOMIZE_EDITBUTTONIMAGE

        MENUITEM "Выбрать з&начок для кнопки",  XTP_ID_CUSTOMIZE_CHANGEBUTTONIMAGE

        MENUITEM SEPARATOR
        MENUITEM "&Основной стиль",             XTP_ID_CUSTOMIZE_DEFAULTSTYLE

        MENUITEM "Тол&ько текст",               XTP_ID_CUSTOMIZE_TEXTONLY
        MENUITEM "Значок и &текст",             XTP_ID_CUSTOMIZE_IMAGEANDTEXT

        MENUITEM SEPARATOR
        MENUITEM "Начать &группу",              XTP_ID_CUSTOMIZE_BEGINAGROUP
    END
END


