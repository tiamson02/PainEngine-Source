inline int	hkGroupFilter::getNewSystemGroup()
{
	return ++m_nextFreeSystemGroup;
}

inline hkUint32 hkGroupFilter::calcFilterInfo( int layer, int systemGroup)
{
	HK_ASSERT( layer >=0 && layer < 32 );
	HK_ASSERT( systemGroup>=0 && systemGroup < 0x10000);
	return hkUint32((systemGroup<<16) | layer);
}


