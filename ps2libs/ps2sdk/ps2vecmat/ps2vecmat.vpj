[GLOBAL]
workingdir=.
version=7.0
packname=(None)
MACRO=\n
[CONFIGURATIONS]
config=,Release
[COMPILER.Release]
compile=copts: concur|capture|savecurrent|menu: Compile:&Compilecmd: otheropts: 
make=copts: concur|capture|saveworkspacefiles|menu: Build:&Buildcmd: makeotheropts: 
rebuild=copts: concur|capture|saveworkspacefiles|menu: Rebuild:&Rebuildcmd: otheropts: 
debug=copts: |menu: Debug:&Debugcmd: otheropts: 
execute=copts: concur|capture|menu: Execute:E&xecutecmd: make xrunotheropts: 
includedirs=
sysincludedirs=
reffile=
libs=
outputfile=
prebuildcmds=
postbuildcmds=
stoponprebuilderrors=0
stoponpostbuilderrors=0
[FILES]
Makefile
Makefile.work
README
include/core_matrix.h
include/core_vector.h
include/cpu_matrix.h
include/cpu_vector.h
include/ps2_matrix.h
include/ps2_vector.h
include/vu0_matrix.h
include/vu0_vector.h
scripts/gen_matrix_h.perl
scripts/gen_vector_h.perl
src/core_matrix.cpp
src/vu0_matrix.cpp
[ASSOCIATION]
